---
interface Props { height?: number }
const { height = 18 } = Astro.props;
---
<svg height={height} viewBox="0 0 90 36" aria-hidden="true" focusable="false" class="ebay-mark"><text x="0" y="29" font-family="Arial, Helvetica, sans-serif" font-size="34" font-weight="700" letter-spacing="-2"><tspan fill="#e53238">e</tspan><tspan fill="#0064d2">b</tspan><tspan fill="#f5af02">a</tspan><tspan fill="#86b817">y</tspan></text></svg>
