---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Crumb } from '../../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageCaption?: string;
  crumbs?: Crumb[];
  points?: string[];
  imagePosition?: string;
}
const { eyebrow, title, lead, image, imageAlt = '', imageCaption, crumbs = [], points = [], imagePosition = 'center' } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    {crumbs.length > 0 && <Breadcrumbs crumbs={crumbs} />}
    <div class:list={['hero-grid', { 'has-image': !!image }]}>
      <div class="hero-copy">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 set:html={title} />
        {lead && <p class="lead">{lead}</p>}
        {points.length > 0 && (
          <ul class="hero-points">
            {points.map((p) => <li><Icon name="CircleCheck" size={20} /> <span set:html={p} /></li>)}
          </ul>
        )}
        <div class="btn-row hero-actions"><slot name="actions" /></div>
        <slot />
      </div>
      {image && (
        <figure class="hero-media">
          <div class="media-frame">
            <Image src={image} alt={imageAlt} widths={[480, 720, 960, 1200]} sizes="(min-width: 900px) 46vw, 100vw" loading="eager" fetchpriority="high" style={`object-position:${imagePosition}`} />
          </div>
          {imageCaption && <figcaption>{imageCaption}</figcaption>}
        </figure>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero { padding-block: clamp(24px, 4vw, 56px) clamp(48px, 6vw, 80px); background: linear-gradient(180deg, var(--white) 0%, var(--paper) 100%); }
  .hero-grid { display: grid; gap: clamp(28px, 5vw, 64px); align-items: center; }
  @media (min-width: 900px) { .hero-grid.has-image { grid-template-columns: 1.05fr 0.95fr; } }
  .hero-copy { max-width: 680px; }
  .hero-copy :global(h1) { margin-bottom: 0.35em; }
  .hero-copy .lead { margin-bottom: 1.4em; }
  .hero-points { list-style: none; padding: 0; margin: 0 0 1.6em; display: grid; gap: 10px; }
  .hero-points li { display: flex; gap: 10px; align-items: flex-start; font-weight: 600; }
  .hero-points :global(svg) { color: var(--green); flex: none; margin-top: 2px; }
  .hero-actions:empty { display: none; }
  .hero-media { margin: 0; }
  .hero-media .media-frame { aspect-ratio: 4 / 3.2; }
  .hero-media figcaption { font-size: 0.82rem; color: var(--muted); margin-top: 10px; }
</style>
