---
import { site } from '../../data/site';
import { reviewsFor, featuredReviews, type ReviewTag, type Review } from '../../data/reviews';
import { getGoogleSummary } from '../../lib/google-reviews';
import Stars from '../ui/Stars.astro';
import GoogleG from '../ui/GoogleG.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  tags?: ReviewTag[];
  limit?: number;
  title?: string;
  intro?: string;
  includeLive?: boolean;
  background?: 'white' | 'paper' | 'paper-2';
  layout?: 'scroll' | 'grid';
}
const { tags, limit = 6, title = 'What our customers say', intro, includeLive = true, background = 'paper', layout = 'scroll' } = Astro.props;
const google = await getGoogleSummary();

type Card = { author: string; text: string; meta: string; rating: number; url?: string; photo?: string };
const live: Card[] = includeLive
  ? google.live.map((r) => ({ author: r.author, text: r.text, meta: r.relativeTime, rating: r.rating, url: r.authorUrl, photo: r.photo }))
  : [];
const picked: Review[] = tags ? reviewsFor(tags, limit) : featuredReviews().slice(0, limit);
const staticCards: Card[] = picked.map((r) => ({ author: r.author, text: r.text, meta: String(r.year), rating: r.rating ?? 5 }));
const seen = new Set(live.map((l) => l.author));
const cards = [...live, ...staticCards.filter((c) => !seen.has(c.author))].slice(0, Math.max(limit, live.length));
const initials = (n: string) => n.split(/\s+/).map((p) => p[0]).slice(0, 2).join('').toUpperCase();
---
<section class:list={['section reviews', `bg-${background}`]}>
  <div class="container">
    <div class="reviews-head">
      <div class="section-head mb-0">
        <p class="eyebrow">Google reviews</p>
        <h2>{title}</h2>
        {intro && <p>{intro}</p>}
      </div>
      <a class="g-summary" href={site.google.reviewsUrl} target="_blank" rel="noopener">
        <GoogleG size={34} />
        <span>
          <span class="g-score">{google.rating.toFixed(1)} <Stars rating={google.rating} size={18} label={false} /></span>
          <small>Based on {google.reviewCount}+ reviews · Read them on Google</small>
        </span>
      </a>
    </div>

    <ul class:list={['review-list', layout]} role="list">
      {cards.map((c) => (
        <li class="review-card">
          <div class="review-top">
            {c.photo ? <img class="avatar" src={c.photo} alt="" width="40" height="40" loading="lazy" referrerpolicy="no-referrer" /> : <span class="avatar" aria-hidden="true">{initials(c.author)}</span>}
            <span class="review-who">
              {c.url ? <a href={c.url} target="_blank" rel="noopener nofollow">{c.author}</a> : <strong>{c.author}</strong>}
              <small>{c.meta}</small>
            </span>
            <GoogleG size={18} />
          </div>
          <Stars rating={c.rating} size={15} />
          <blockquote>{c.text}</blockquote>
        </li>
      ))}
    </ul>

    <div class="btn-row reviews-actions">
      <a href="/reviews/" class="btn btn-outline">More customer reviews <Icon name="ArrowRight" /></a>
      <a href={site.google.reviewsUrl} target="_blank" rel="noopener" class="link-arrow">All {google.reviewCount}+ reviews on Google <Icon name="ArrowUpRight" /></a>
    </div>
  </div>
</section>

<style>
  .reviews-head { display: flex; flex-wrap: wrap; gap: 20px 40px; align-items: flex-end; justify-content: space-between; margin-bottom: clamp(24px, 3.5vw, 40px); }
  .g-summary { display: inline-flex; align-items: center; gap: 14px; padding: 14px 20px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; box-shadow: var(--shadow-sm); }
  .g-summary:hover { border-color: var(--line-strong); box-shadow: var(--shadow); }
  .g-score { display: flex; align-items: center; gap: 10px; font-size: 1.6rem; font-weight: 850; font-stretch: 110%; line-height: 1; }
  .g-summary small { color: var(--muted); font-size: 0.85rem; }

  .review-list { list-style: none; margin: 0; padding: 0; }
  .review-list.grid { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .review-list.scroll {
    display: grid; grid-auto-flow: column; grid-auto-columns: min(86%, 360px); gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 4px 4px 16px; margin-inline: -4px; scrollbar-width: thin;
  }
  .review-list.scroll .review-card { scroll-snap-align: start; }
  .review-card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; display: flex; flex-direction: column; gap: 10px; }
  .bg-white .review-card { background: var(--paper); }
  .review-top { display: flex; align-items: center; gap: 12px; }
  .review-top > :global(svg:last-child) { margin-left: auto; }
  .avatar { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--accent); font-weight: 800; font-size: 0.85rem; flex: none; object-fit: cover; }
  .review-who { display: flex; flex-direction: column; line-height: 1.2; }
  .review-who a, .review-who strong { font-weight: 750; text-decoration: none; }
  .review-who small { color: var(--muted); font-size: 0.8rem; }
  blockquote { margin: 0; font-size: 0.98rem; line-height: 1.6; color: var(--ink-2); }
  .reviews-actions { margin-top: 24px; gap: 20px; }
</style>
