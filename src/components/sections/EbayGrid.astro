---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ebayUrl } from '../../lib/ebay';
import Icon from '../ui/Icon.astro';

export interface EbayTile { title: string; text?: string; image: ImageMetadata; alt: string; query: string; conditions?: ('used' | 'new' | 'any')[] }
interface Props { tiles: EbayTile[]; columns?: 3 | 4 }
const { tiles, columns = 3 } = Astro.props;
const label = { used: 'Shop used', new: 'Shop new', any: 'Shop all' } as const;
---
<ul class:list={['ebay-grid', `cols-${columns}`]} role="list">
  {tiles.map((t) => {
    const conds = t.conditions ?? ['used', 'new'];
    return (
      <li class="card card-media card-link ebay-tile">
        <Image src={t.image} alt={t.alt} widths={[360, 540, 720]} sizes="(min-width: 1000px) 30vw, (min-width: 640px) 45vw, 100vw" />
        <div class="card-body">
          <h3>{t.title}</h3>
          {t.text && <p class="muted">{t.text}</p>}
          <div class="ebay-links">
            {conds.map((c, i) => (
              <a href={ebayUrl(t.query, c)} target="_blank" rel="noopener" class:list={['btn btn-sm', i === 0 ? 'btn-dark' : 'btn-outline', { stretched: i === 0 }]}>
                {label[c]} <Icon name="ArrowUpRight" size={16} />
              </a>
            ))}
          </div>
        </div>
      </li>
    );
  })}
</ul>
<p class="ebay-note"><Icon name="Info" size={16} /> Opens our live eBay listings, so you always see current stock and prices. Can't see what you need? <a href="/contact/">Ask us</a>, as not everything we have is listed.</p>
<style>
  .ebay-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  @media (min-width: 1100px) { .ebay-grid.cols-4 { grid-template-columns: repeat(4, 1fr); } .ebay-grid.cols-3 { grid-template-columns: repeat(3, 1fr); } }
  .ebay-tile h3 { font-size: 1.2rem; }
  .ebay-tile p { font-size: 0.95rem; }
  .ebay-links { display: flex; flex-wrap: wrap; gap: 8px; position: relative; z-index: 1; }
  .ebay-links a:not(.stretched) { position: relative; z-index: 2; }
  .ebay-note { display: flex; gap: 8px; align-items: flex-start; margin-top: 18px; font-size: 0.9rem; color: var(--muted); }
  .ebay-note :global(svg) { flex: none; margin-top: 3px; }
</style>
