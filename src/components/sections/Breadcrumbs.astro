---
import type { Crumb } from '../../layouts/BaseLayout.astro';
interface Props { crumbs: Crumb[]; light?: boolean }
const { crumbs, light = false } = Astro.props;
---
<nav aria-label="Breadcrumb" class:list={['crumbs', { light }]}>
  <ol>
    <li><a href="/">Home</a></li>
    {crumbs.map((c, i) => (
      <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0 0 18px; font-size: 0.86rem; color: var(--muted); }
  .crumbs li + li::before { content: '/'; margin-right: 6px; opacity: 0.6; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; color: var(--ink); }
  .crumbs.light ol { color: rgb(255 255 255 / 0.7); }
  .crumbs.light a:hover { color: var(--white); }
</style>
