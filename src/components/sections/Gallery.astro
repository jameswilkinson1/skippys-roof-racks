---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { images: { src: ImageMetadata; alt: string }[]; caption?: string }
const { images, caption } = Astro.props;
---
<figure class="gallery">
  <ul role="list">
    {images.map((img) => (
      <li><Image src={img.src} alt={img.alt} widths={[320, 480, 640]} sizes="(min-width: 1000px) 25vw, 50vw" /></li>
    ))}
  </ul>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .gallery { margin: 0; }
  .gallery ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 760px) { .gallery ul { grid-template-columns: repeat(4, 1fr); } }
  .gallery li { border-radius: var(--radius); overflow: hidden; aspect-ratio: 1; background: var(--paper-2); }
  .gallery img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .gallery li:hover img { transform: scale(1.04); }
  .gallery figcaption { margin-top: 12px; font-size: 0.85rem; color: var(--muted); }
</style>
