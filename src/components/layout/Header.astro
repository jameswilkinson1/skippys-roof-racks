---
import { site, nav } from '../../data/site';
import { getGoogleSummary } from '../../lib/google-reviews';
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import Stars from '../ui/Stars.astro';

const google = await getGoogleSummary();
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<div class="topbar on-dark">
  <div class="container topbar-inner">
    <a class="topbar-item topbar-rating" href={site.google.reviewsUrl} target="_blank" rel="noopener">
      <Stars rating={google.rating} size={14} label={false} />
      <span><strong>{google.rating.toFixed(1)}</strong> on Google · {google.reviewCount}+ reviews</span>
    </a>
    <span class="topbar-item topbar-claim"><Icon name="BadgeCheck" size={16} /> {site.thule.claim}</span>
    <span class="topbar-item topbar-hours" data-open-status>
      <Icon name="Clock" size={16} /> <span data-open-text>Mon–Fri 8:30–4 · Sat 9–12</span>
    </span>
  </div>
</div>

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      <Logo />
    </a>

    <nav class="main-nav" aria-label="Main" data-nav>
      <ul class="nav-list">
        {nav.map((item) =>
          'children' in item && item.children ? (
            <li class="has-sub">
              <button class:list={['nav-link', 'sub-toggle', { active: item.children.some((c) => isActive(c.href)) }]} aria-expanded="false" data-sub-toggle>
                {item.label} <Icon name="ChevronDown" size={16} />
              </button>
              <ul class="sub-menu">
                {item.children.map((c) => (
                  <li><a href={c.href} class:list={['sub-link', { active: isActive(c.href) }]}>{c.label}</a></li>
                ))}
                <li class="sub-ebay">
                  <a href={site.ebay.storeUrl} target="_blank" rel="noopener" class="sub-link">
                    Browse everything on eBay <Icon name="ArrowUpRight" size={16} />
                  </a>
                </li>
              </ul>
            </li>
          ) : (
            <li><a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
          )
        )}
      </ul>
      <div class="nav-mobile-ctas">
        <a href={site.phoneHref} class="btn btn-dark btn-block"><Icon name="Phone" /> Call {site.phone}</a>
        <a href="/roof-box-hire/#book" class="btn btn-primary btn-block"><Icon name="CalendarCheck" /> Book roof box hire</a>
      </div>
    </nav>

    <div class="header-ctas">
      <a href={site.phoneHref} class="header-phone" aria-label={`Call ${site.phone}`}>
        <span class="header-phone-icon"><Icon name="Phone" size={18} /></span>
        <span class="header-phone-text"><small>Call us</small>{site.phone}</span>
      </a>
      <a href="/roof-box-hire/#book" class="btn btn-primary btn-sm header-book">Book hire</a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
        <span class="sr-only">Menu</span>
        <span class="menu-icon-open"><Icon name="Menu" size={26} /></span>
        <span class="menu-icon-close"><Icon name="X" size={26} /></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Mobile menu + dropdowns
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    if (open && header) header.style.setProperty('--nav-top', `${header.getBoundingClientRect().bottom}px`);
    toggle.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('menu-open', open);
    document.documentElement.classList.toggle('no-scroll', open);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-sub-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      document.querySelectorAll('[data-sub-toggle]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      btn.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.has-sub')) {
      document.querySelectorAll('[data-sub-toggle]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('[data-sub-toggle]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      if (header?.classList.contains('menu-open')) toggle?.click();
    }
  });

  // "Open now" status in UK time
  const el = document.querySelector('[data-open-text]');
  if (el) {
    const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
    const day = get('weekday');
    const mins = Number(get('hour')) * 60 + Number(get('minute'));
    const weekday = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'].includes(day);
    const open = (weekday && mins >= 510 && mins < 960) || (day === 'Sat' && mins >= 540 && mins < 720);
    const closes = day === 'Sat' ? '12pm' : '4pm';
    el.textContent = open ? `Open now · closes ${closes}` : weekday && mins < 510 ? 'Opens today 8:30am' : day === 'Sat' && mins < 540 ? 'Opens today 9am' : day === 'Fri' || day === 'Sat' || day === 'Sun' ? (day === 'Fri' ? 'Opens Sat 9am' : 'Opens Mon 8:30am') : 'Opens tomorrow 8:30am';
    el.closest('[data-open-status]')?.classList.toggle('is-open', open);
  }
</script>

<style>
  .topbar { background: var(--ink); color: rgb(255 255 255 / 0.86); font-size: 0.84rem; }
  .topbar-inner { display: flex; align-items: center; justify-content: space-between; gap: 18px; min-height: 38px; }
  .topbar-item { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; text-decoration: none; }
  .topbar-item :global(svg) { flex: none; }
  .topbar-claim { color: var(--accent); font-weight: 650; }
  .topbar-hours.is-open :global(svg) { color: #5fd38a; }
  .topbar-rating:hover span { text-decoration: underline; }
  @media (max-width: 899px) {
    .topbar-inner { justify-content: center; }
    .topbar-rating, .topbar-hours { display: none; }
    .topbar-claim { font-size: 0.78rem; white-space: normal; text-align: center; }
  }

  .site-header {
    /* no backdrop-filter: it would trap the fixed-position mobile menu */
    position: sticky; top: 0; z-index: 50; background: var(--white); border-bottom: 1px solid var(--line);
  }
  .header-inner { display: flex; align-items: center; gap: 20px; min-height: var(--header-h); }
  .brand { display: block; flex: none; color: var(--ink); }
  .brand :global(.logo-svg) { height: 54px; width: auto; }

  .main-nav { margin-left: auto; }
  .nav-list { display: flex; align-items: center; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav-link {
    display: inline-flex; align-items: center; gap: 4px; padding: 10px 12px; border-radius: 999px;
    font-weight: 700; font-size: 0.96rem; font-stretch: 105%; text-decoration: none; background: none; border: 0; cursor: pointer;
  }
  .nav-link:hover, .nav-link.active { background: var(--paper-2); text-decoration: none; }
  .nav-link.active { box-shadow: inset 0 -3px 0 var(--accent); }
  .sub-toggle :global(svg) { transition: transform 0.2s; }
  .sub-toggle[aria-expanded='true'] :global(svg) { transform: rotate(180deg); }
  .has-sub { position: relative; }
  .sub-menu {
    list-style: none; margin: 0; padding: 8px; position: absolute; top: calc(100% + 8px); left: 0; min-width: 280px;
    background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-lg);
    opacity: 0; visibility: hidden; transform: translateY(-6px); transition: 0.16s ease;
  }
  .sub-toggle[aria-expanded='true'] + .sub-menu { opacity: 1; visibility: visible; transform: none; }
  @media (hover: hover) and (min-width: 1100px) {
    .has-sub:hover .sub-menu { opacity: 1; visibility: visible; transform: none; }
    .has-sub::after { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 12px; }
  }
  .sub-link { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 12px; border-radius: var(--radius-sm); font-weight: 650; text-decoration: none; }
  .sub-link:hover, .sub-link.active { background: var(--paper-2); }
  .sub-ebay { border-top: 1px solid var(--line); margin-top: 6px; padding-top: 6px; }
  .sub-ebay .sub-link { color: var(--muted); }

  .header-ctas { display: flex; align-items: center; gap: 12px; }
  .header-phone { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 800; font-stretch: 108%; }
  .header-phone-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--paper-2); }
  .header-phone-text { display: flex; flex-direction: column; line-height: 1.1; white-space: nowrap; }
  .header-phone-text small { font-size: 0.72rem; color: var(--muted); font-weight: 650; text-transform: uppercase; letter-spacing: 0.08em; }
  .menu-toggle { display: none; background: none; border: 0; padding: 8px; cursor: pointer; border-radius: 10px; }
  .menu-icon-close { display: none; }
  .nav-mobile-ctas { display: none; }

  @media (max-width: 1240px) { .header-phone-text { display: none; } }
  @media (max-width: 1099px) {
    .brand :global(.logo-svg) { height: 46px; }
    .menu-toggle { display: inline-grid; place-items: center; }
    .header-ctas { margin-left: auto; }
    .header-book { display: none; }
    .main-nav {
      position: fixed; top: var(--nav-top, 110px); left: 0; right: 0; bottom: 0; background: var(--white); padding: 12px var(--gutter) 32px;
      overflow-y: auto; transform: translateX(100%); transition: transform 0.25s ease; visibility: hidden; margin: 0;
    }
    .menu-open .main-nav { transform: none; visibility: visible; }
    .menu-open .menu-icon-open { display: none; }
    .menu-open .menu-icon-close { display: inline; }
    .nav-list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav-list > li { border-bottom: 1px solid var(--line); }
    .nav-link { width: 100%; justify-content: space-between; padding: 16px 4px; font-size: 1.15rem; border-radius: 0; }
    .nav-link.active { box-shadow: none; background: none; }
    .sub-menu { position: static; box-shadow: none; border: 0; padding: 0 0 12px; min-width: 0; display: none; opacity: 1; visibility: visible; transform: none; }
    .sub-toggle[aria-expanded='true'] + .sub-menu { display: block; }
    .nav-mobile-ctas { display: grid; gap: 12px; margin-top: 24px; }
  }
  :global(html.no-scroll) { overflow: hidden; }
</style>
