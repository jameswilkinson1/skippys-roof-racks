---
import { site } from '../../data/site';
import { ebayUrl } from '../../lib/ebay';
import Icon from '../ui/Icon.astro';
---
<nav class="mobile-bar" aria-label="Quick actions">
  <a href={site.phoneHref}><Icon name="Phone" /><span>Call</span></a>
  <a href="/roof-box-hire/#book" class="mb-primary"><Icon name="CalendarCheck" /><span>Book hire</span></a>
  <a href={ebayUrl()} target="_blank" rel="noopener"><Icon name="ShoppingBag" /><span>Shop eBay</span></a>
  {site.whatsapp ? (
    <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener"><Icon name="MessageCircle" /><span>WhatsApp</span></a>
  ) : (
    <a href="/contact/"><Icon name="Mail" /><span>Message</span></a>
  )}
</nav>

<style>
  .mobile-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; display: grid; grid-template-columns: repeat(4, 1fr);
    background: var(--white); border-top: 1px solid var(--line); box-shadow: 0 -8px 24px rgb(0 0 0 / 0.08);
    padding: 6px 6px calc(6px + env(safe-area-inset-bottom));
  }
  .mobile-bar a {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-height: 56px;
    border-radius: 12px; font-size: 0.76rem; font-weight: 750; text-decoration: none; color: var(--ink);
  }
  .mobile-bar a :global(svg) { width: 22px; height: 22px; }
  .mobile-bar .mb-primary { background: var(--accent); }
  @media (min-width: 900px) { .mobile-bar { display: none; } }
  :global(html.no-scroll) .mobile-bar { display: none; }
</style>
