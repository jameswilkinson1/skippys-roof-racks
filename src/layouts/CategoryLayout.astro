---
/** Shared layout for the Thule category pages (roof boxes, bars, bikes, more). */
import type { ImageMetadata } from 'astro';
import BaseLayout, { type Crumb } from './BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import EbayGrid, { type EbayTile } from '../components/sections/EbayGrid.astro';
import Reviews from '../components/sections/Reviews.astro';
import FAQ from '../components/sections/FAQ.astro';
import CTABand from '../components/sections/CTABand.astro';
import RelatedGuides from '../components/sections/RelatedGuides.astro';
import Icon from '../components/ui/Icon.astro';
import type { ReviewTag } from '../data/reviews';
import { ebayUrl } from '../lib/ebay';

interface Props {
  seoTitle: string;
  seoDescription: string;
  crumbs: Crumb[];
  eyebrow: string;
  title: string;
  lead: string;
  points: string[];
  image: ImageMetadata;
  imageAlt: string;
  query: string;
  tilesTitle: string;
  tilesIntro: string;
  tiles: EbayTile[];
  faqs: { q: string; a: string }[];
  reviewTags: ReviewTag[];
  reviewTitle?: string;
  guides: string[];
  cta?: { title: string; text: string; label: string; href: string; icon: string };
}
const p = Astro.props;
---
<BaseLayout title={p.seoTitle} description={p.seoDescription} image={p.image} crumbs={p.crumbs}>
  <PageHero eyebrow={p.eyebrow} title={p.title} lead={p.lead} points={p.points} image={p.image} imageAlt={p.imageAlt} crumbs={p.crumbs}>
    <Fragment slot="actions">
      <a href={ebayUrl(p.query, 'used')} target="_blank" rel="noopener" class="btn btn-primary btn-lg"><Icon name="ShoppingBag" /> Shop used</a>
      <a href={ebayUrl(p.query, 'new')} target="_blank" rel="noopener" class="btn btn-dark btn-lg">Shop new</a>
    </Fragment>
    <p class="hero-sub"><a href="/which-roof-bars-fit-my-car/">Not sure what fits your car? Ask us →</a></p>
  </PageHero>
  <TrustStrip />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Shop on eBay</p>
        <h2>{p.tilesTitle}</h2>
        <p>{p.tilesIntro}</p>
      </div>
      <EbayGrid tiles={p.tiles} />
    </div>
  </section>

  <slot />

  <Reviews tags={p.reviewTags} title={p.reviewTitle ?? 'What customers say'} background="paper-2" />
  <FAQ faqs={p.faqs} />
  {p.cta ? (
    <CTABand title={p.cta.title} text={p.cta.text} primaryLabel={p.cta.label} primaryHref={p.cta.href} icon={p.cta.icon} />
  ) : (
    <CTABand />
  )}
  <RelatedGuides slugs={p.guides} />
</BaseLayout>
<style>
  .hero-sub { margin-top: 18px; font-weight: 700; }
  .hero-sub a { text-decoration-color: var(--accent); text-decoration-thickness: 3px; }
</style>
