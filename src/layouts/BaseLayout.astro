---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileBar from '../components/layout/MobileBar.astro';
import defaultOg from '../assets/images/site/yard-mercedes-roof-box.jpg';

export interface Crumb { name: string; href: string }

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  crumbs?: Crumb[];
  schema?: Record<string, unknown>[];
}

const { title, description, image, noindex: pageNoindex = false, type = 'website', crumbs = [], schema = [] } = Astro.props;
// The whole site is noindex until PUBLIC_SITE_LIVE=true is set for the launch build
const noindex = pageNoindex || import.meta.env.PUBLIC_SITE_LIVE !== 'true';
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title.includes("Skippy") ? title : `${title} | ${site.name}`;
const og = await getImage({ src: image ?? defaultOg, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const ogUrl = new URL(og.src, site.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'AutoPartsStore',
  '@id': `${site.url}/#business`,
  name: site.name,
  legalName: site.legalName,
  description: `Family-run Thule specialists since ${site.since}: roof box and roof bar hire, new and used Thule roof boxes, roof bars and bike carriers, free fitting with purchase, and Thule repairs and spare parts. ${site.thule.claim}.`,
  url: site.url,
  logo: `${site.url}/favicon.svg`,
  image: ogUrl,
  telephone: '+441473785810',
  email: site.email,
  foundingDate: String(site.since),
  vatID: site.vatNumber,
  priceRange: '££',
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.line1}, ${site.address.line2}, ${site.address.locality}`,
    addressLocality: site.address.town,
    addressRegion: site.address.county,
    postalCode: site.address.postcode,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.google.mapsUrl,
  openingHoursSpecification: site.hours
    .filter((h) => h.open)
    .map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.schemaDays, opens: h.open, closes: h.close })),
  areaServed: [{ '@type': 'AdministrativeArea', name: 'Suffolk' }, { '@type': 'Country', name: 'United Kingdom' }],
  sameAs: [site.social.facebook, site.ebay.storeUrl, site.google.mapsUrl],
  brand: { '@type': 'Brand', name: 'Thule' },
};

const breadcrumbSchema = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.href, site.url).href,
      })),
    }
  : null;

const allSchema = [business, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...schema];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#121211" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="geo.region" content="GB-SFK" />
    <meta name="geo.placename" content={`${site.address.locality}, ${site.address.town}`} />
    <meta name="format-detection" content="telephone=no" />

    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
  </body>
</html>
