---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/sections/Breadcrumbs.astro';
import GuideCard from '../../components/sections/GuideCard.astro';
import FAQ from '../../components/sections/FAQ.astro';
import CTABox from '../../components/mdx/CTABox.astro';
import Callout from '../../components/mdx/Callout.astro';
import Icon from '../../components/ui/Icon.astro';
import Logo from '../../components/ui/Logo.astro';
import { categoryLabels } from '../../data/guides';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

interface Props { guide: CollectionEntry<'guides'> }
const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const d = guide.data;
const all = await getCollection('guides', ({ data }) => !data.draft);
const related = [
  ...d.related.map((s) => all.find((g) => g.id === s)),
  ...all.filter((g) => g.data.category === d.category && g.id !== guide.id),
].filter((g, i, arr): g is CollectionEntry<'guides'> => !!g && g.id !== guide.id && arr.findIndex((x) => x?.id === g.id) === i).slice(0, 3);
const toc = headings.filter((h) => h.depth === 2);
const crumbs = [{ name: 'Guides', href: '/guides/' }, { name: d.title, href: `/guides/${guide.id}/` }];
const fmt = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const words = (guide.body ?? '').split(/\s+/).length;
const minutes = Math.max(3, Math.round(words / 220));

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: { '@id': `${site.url}/#business` },
  mainEntityOfPage: new URL(`/guides/${guide.id}/`, site.url).href,
  articleSection: categoryLabels[d.category],
};
---
<BaseLayout title={d.title} description={d.description} image={d.image} type="article" crumbs={crumbs} schema={[articleSchema]}>
  <article>
    <header class="article-head">
      <div class="container container-narrow">
        <Breadcrumbs crumbs={crumbs} />
        <a class="pill" href={`/guides/#${d.category}`}>{categoryLabels[d.category]}</a>
        <h1>{d.title}</h1>
        <p class="lead">{d.description}</p>
        <p class="meta">
          <span><Icon name="BookOpen" size={16} /> {minutes} min read</span>
          <span><Icon name="Calendar" size={16} /> {d.updatedDate ? `Updated ${fmt(d.updatedDate)}` : fmt(d.pubDate)}</span>
          <span><Icon name="BadgeCheck" size={16} /> By the Skippy's team</span>
        </p>
      </div>
      <div class="container article-hero">
        <div class="media-frame ratio-16-10">
          <Image src={d.image} alt={d.imageAlt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1100px) 1000px, 100vw" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </header>

    <div class="container article-layout">
      <aside class="toc-wrap" aria-label="On this page">
        {toc.length > 2 && (
          <nav class="toc">
            <p class="toc-title">On this page</p>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="side-cta">
          <p><strong>Need advice?</strong> Talk to a Thule specialist.</p>
          <a href={site.phoneHref} class="btn btn-dark btn-sm btn-block"><Icon name="Phone" /> {site.phone}</a>
        </div>
      </aside>

      <div class="article-main">
        <div class="quick-answer">
          <p class="qa-label"><Icon name="Zap" size={18} /> Quick answer</p>
          <p>{d.quickAnswer}</p>
        </div>
        <div class="prose">
          <Content components={{ CTABox, Callout }} />
        </div>
        <CTABox type={d.cta} />
        <div class="author-box">
          <span class="author-logo"><Logo variant="mark" /></span>
          <div>
            <p class="author-name">Written by the team at {site.name}</p>
            <p class="muted">Family-run Thule specialists in Tuddenham, Ipswich since {site.since}, and the only official Thule Service Centre in the UK. We hire, sell, fit and repair Thule kit every day. <a href="/about/">About us</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </article>

  {d.faqs.length > 0 && <FAQ faqs={d.faqs} title="More questions" background="white" />}

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head"><p class="eyebrow">Keep reading</p><h2>Related guides</h2></div>
        <div class="grid grid-3">{related.map((g) => <GuideCard guide={g} />)}</div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .article-head { padding-top: clamp(24px, 4vw, 48px); background: linear-gradient(180deg, var(--white) 0%, var(--white) 70%, var(--paper) 70%); }
  .article-head .pill { text-decoration: none; margin-bottom: 16px; }
  .article-head h1 { font-size: clamp(2rem, 4.6vw, 3.2rem); margin-top: 6px; }
  .article-head .lead { font-size: 1.15rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 22px; color: var(--muted); font-size: 0.9rem; font-weight: 600; margin: 18px 0 28px; }
  .meta span { display: inline-flex; align-items: center; gap: 6px; }
  .article-hero { max-width: 1060px; }
  .article-layout { display: grid; gap: 40px; padding-block: clamp(32px, 5vw, 56px) clamp(48px, 6vw, 80px); max-width: 1160px; }
  @media (min-width: 1060px) { .article-layout { grid-template-columns: 250px minmax(0, 1fr); gap: 56px; } .toc-wrap { position: sticky; top: calc(var(--header-h) + 24px); align-self: start; } }
  @media (max-width: 1059px) { .toc-wrap { display: none; } }
  .article-main { max-width: 760px; min-width: 0; }
  .toc { padding: 18px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); margin-bottom: 16px; }
  .toc-title { font-weight: 800; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: 10px; }
  .toc ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  .toc a { display: block; padding: 6px 8px; border-radius: 6px; font-size: 0.92rem; text-decoration: none; line-height: 1.35; }
  .toc a:hover { background: var(--paper-2); }
  .side-cta { padding: 18px; background: var(--accent); border-radius: var(--radius); font-size: 0.95rem; }
  .side-cta p { margin-bottom: 12px; }
  .quick-answer { padding: 20px 22px; background: var(--ink); color: var(--white); border-radius: var(--radius); margin-bottom: 32px; font-size: 1.08rem; line-height: 1.6; }
  .quick-answer p { margin: 0; }
  .qa-label { display: flex; align-items: center; gap: 6px; color: var(--accent); font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; margin-bottom: 8px !important; }
  .author-box { display: flex; gap: 18px; align-items: flex-start; margin-top: 40px; padding: 22px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); }
  .author-logo { flex: none; width: 64px; height: 64px; border-radius: 16px; background: var(--accent); display: grid; place-items: center; padding: 8px; }
  .author-logo :global(svg) { width: 100%; height: auto; }
  .author-name { font-weight: 800; margin-bottom: 4px; }
  .author-box .muted { margin: 0; font-size: 0.95rem; }
</style>
